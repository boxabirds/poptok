# One piece = one song's video. Copy this folder to pieces/<name>/ and fill in inputs/.
# Paths are relative to this folder.

LYRICS=inputs/lyrics.txt                  # master lyrics with [Verse] / [Chorus] ... tags (required)
TREATMENT=inputs/visual-treatment.txt     # the look of the whole video, a line or a paragraph
# STYLE="gritty lo-fi black and white"    # instead of TREATMENT: the older per-line method with a fixed style

SONG=inputs/song.wav                      # an existing song; leave empty to generate one from MUSIC_STYLE
# MUSIC_STYLE=inputs/music-style.txt      # genre, tempo, instruments, vocals ... (condensed to < 512 chars if longer)
# SONG_SEEDS=1,2,3                        # songs generated; the one whose lyrics are most intelligible is kept
# SONG_DURATION=auto                      # or seconds (10-600)

RUN=v1                                    # outputs/<RUN>/ ; change it to keep earlier versions
# VIDEO_HOST=thing2                       # render the video on another box over ssh (default: this one)

# Per-piece tuning (defaults shown):
# LTX_ARGS="--even-light"                 # pipeline/ltx_chain.py: --lead 0.9 --lora-strength 1.0 --seed-base 3000
# FINISH_ARGS="--deflare 8"               # pipeline/finish.py: --punch-amp 0.05 --punch-min-gap 1.5 --step N
# MERGE_ARGS=""                           # pipeline/merge_scenes.py: --max-bars 3
