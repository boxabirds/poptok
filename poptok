#!/usr/bin/env bash
# poptok: lyrics + visual treatment (+ a song, or a music style to generate one) -> music video; or a prompt alone ->
# lyrics, song, treatment and music video.
#
#   ./poptok pieces/NAME [--plan-only] [--run RUN] [--explain] [--redo STEP,...] [--accept STEP,...] [--until STEP]
#
# A piece is one folder (see pieces.example/): piece.env (its settings), inputs/ (lyrics, visual look, song or
# music style), analysis/ and outputs/ (both written here). Paths in piece.env are relative to the piece folder.
#   SONG set          -> video from that song
#   SONG empty        -> song generated from MUSIC_STYLE + LYRICS with ACE-Step (best of SONG_SEEDS by lyric match),
#                        written to outputs/song.wav, then the video
#   SONG_PROMPT set   -> the songwriters' workshop writes LYRICS and MUSIC_STYLE from the prompt first (SONG_FORM:
#                        the structure); with WORKSHOP=1 the directors then write the story: end to end from a prompt
#   WORKSHOP=1        -> the directors' workshop writes the TREATMENT (inputs/story.md, the whole story in prose, which
#                        you may edit), then the storyboard built from it (scenes and a shot per line), then the video
# --plan-only stops after the treatment and scene prompts (outputs/RUN/treatment.md), to read and edit before the
# hours of keyframes and video. Re-running the same command resumes.
# Steps run again when their inputs change, like a Makefile but by content: pipeline/steps.ini declares what each step
# is built from (python3 pipeline/steps.py graph draws it), pipeline/deps.py compares hashes. A new
# storyboard, treatment, style or song remakes the prompts and everything after them; old outputs are kept as *.prev.
#   --explain          say which steps would run and why, and run nothing
#   --redo STEP,...    run these steps again even if their inputs haven't changed (after a code change, say)
#   --accept STEP,...  keep these steps' current outputs as they are (hand edits; a piece made before dependency
#                      tracking, whose outputs have no record of what they were built from)
#   --until STEP       stop once STEP is built or up to date (--until universe: make the universe sheet and stop, to
#                      choose one before anything is built from it)
# Steps: songwriters song story universe (these four are never re-run by themselves, only reported, since people edit their
# outputs: --redo STEP reruns one), analysis beats drums segments storyboard prompts keys merge scenes video lipsync.
# LOOK (TREATMENT before 2026-10-25, still read): the visual look file added to every prompt.
set -euo pipefail
cd "$(dirname "$0")"
PIECE=${1:?usage: ./poptok pieces/NAME [--plan-only] [--run RUN]}; shift
PIECE=${PIECE%/}
[ -f "$PIECE/piece.env" ] || { echo "$PIECE/piece.env not found (copy pieces.example/)"; exit 2; }
case $(realpath "$PIECE") in "$PWD"/*) ;; *) echo "the piece folder must be inside $PWD (the containers mount it)"; exit 2;; esac
NAME=$(basename "$PIECE"); SONG=""; LYRICS=""; LOOK=""; TREATMENT=""; STYLE=""; MUSIC_STYLE=""; SONG_SEEDS=1,2,3
SONG_DURATION=auto; VIDEO_HOST=""; RUN=v1; LTX_ARGS="--even-light"; FINISH_ARGS="--deflare 8"; MERGE_ARGS=""
CUES=""; PERFORMER_PHOTO=""; PERFORMER=""
KEY_HOSTS=""
set -a                                                   # site + piece settings reach bin/ scripts
[ -f site.env ] && source site.env                       # this installation: hosts, LLM paths (site.env.example)
source "$PIECE/piece.env"
set +a
LOOK=${LOOK:-$TREATMENT}                                 # the look's old name
EXTRA=()
TEST=""
while [ $# -gt 0 ]; do case $1 in --plan-only) EXTRA+=(--plan-only); shift;; --run) RUN=$2; shift 2;;
  --test) TEST=$2; shift 2;; --explain) export DEPS_DRY=1; shift;;
  --redo) export DEPS_REDO=$2; shift 2;; --accept) export DEPS_ACCEPT=$2; shift 2;;
  --until) export DEPS_UNTIL=$2; shift 2;;
  *) echo "unknown option $1"; exit 2;; esac; done
source bin/deps.sh
if [ -n "${DEPS_DRY:-}" ]; then
  export DEPS_PENDING=$(mktemp); trap 'rm -f "$DEPS_PENDING" "$DEPS_PENDING.seen"' EXIT; echo "$PIECE, run $RUN:"; fi
redo() { [[ ",${DEPS_REDO:-}," == *",$1,"* ]] && echo --force || true; }
# SONG_PROMPT: the songwriters' workshop (pipeline/songwriters.py) writes the lyrics and the music style from a prompt
# (inputs/songwriters.md, lyrics.txt, music-style.txt); the song is then generated from them, as with MUSIC_STYLE
if [ -n "${SONG_PROMPT:-}" ]; then
  LYRICS=${LYRICS:-inputs/lyrics.txt}; MUSIC_STYLE=${MUSIC_STYLE:-inputs/music-style.txt}; SONG=""
  SONG_PROMPT_FILE=$PIECE/$SONG_PROMPT; [ -f "$SONG_PROMPT_FILE" ] || SONG_PROMPT_FILE=""   # a file holding the prompt
  export PIECE SONG_PROMPT_FILE                                                           # (pipeline/steps.ini)
  if need songwriters; then
    echo "[$(date +%H:%M:%S)] songwriters' workshop"
    WORKSHOP_PY=pipeline/songwriters.py bin/workshop.sh "$PIECE" $(redo songwriters); made
  fi
fi
# songwriter lyrics (bare section headings with action hints, whole-line stage directions) -> canonical bracketed form
if [ -n "$LYRICS" ] && [ -f "$PIECE/$LYRICS" ] && \
   [ "$(python3 pipeline/normalise_lyrics.py "$PIECE/$LYRICS" "$PIECE/inputs/lyrics.canonical.txt")" != 0 ]; then
  LYRICS=inputs/lyrics.canonical.txt
else rm -f "$PIECE/inputs/lyrics.canonical.txt"; fi
KEY_HOSTS=${KEY_HOSTS:-${VIDEO_HOST:+$VIDEO_HOST }${KEY_POOL:-local}}
K=""; for h in $KEY_HOSTS; do [[ " ${MAC_HOSTS:-quintus} " == *" $h "* ]] || K="$K $h"; done; KEY_HOSTS=${K# }   # keyframes
                                                   # need a CUDA/ROCm container; a Mac renders video only
p() { [ -n "$1" ] && echo "$PIECE/$1" || true; }           # piece-relative -> repo-relative
# --test SECONDS[@START]: a short test copy of this piece (pieces/NAME-testN/): the song cut to SECONDS from START
# (default: 1 s before the first sung line), only the lyric lines sung there, the full lyrics as prompt context
if [ -n "$TEST" ]; then
  DUR=${TEST%@*}; ST=$([ "$TEST" != "${TEST#*@}" ] && echo "${TEST#*@}" || true)
  [ -n "$SONG" ] || { echo "--test needs SONG"; exit 2; }
  T=$PIECE-test$DUR; mkdir -p "$T/inputs"
  SEGS=$PIECE/analysis/$(basename "${SONG%.*}")-true-segments.json
  [ -f "$SEGS" ] || { echo "--test needs the full piece analysed first ($SEGS)"; exit 2; }
  ST=${ST:-$(python3 -c "import json;print(max(0,json.load(open('$SEGS'))['segments'][0]['start']-1))")}
  ffmpeg -loglevel error -y -ss "$ST" -t "$DUR" -i "$(p "$SONG")" "$T/inputs/song.wav"
  python3 -c "
import json; s=json.load(open('$SEGS'))['segments']
open('$T/inputs/lyrics.txt','w').write('\n'.join(x['text'] for x in s if $ST-0.5 <= x['start'] < $ST+$DUR-0.5)+'\n')"
  cp "$(p "$LYRICS")" "$T/inputs/lyrics-full.txt"
  [ -n "$CUES" ] && cp "$(p "$CUES")" "$T/inputs/cues.txt"
  # the analysis is the full song's, cut to the window (no new Demucs / Whisper; word timings keep full-song context)
  python3 pipeline/slice_analysis.py "$PIECE/analysis" "$(basename "${SONG%.*}")" "$T/analysis" song "$ST" "$DUR"
  { grep -vE '^(SONG|LYRICS|RUN|MUSIC_STYLE|CUES|PERFORMER_PHOTO)=' "$PIECE/piece.env"
    [ -n "$CUES" ] && echo "CUES=inputs/cues.txt"
    [ -n "$PERFORMER_PHOTO" ] && echo "PERFORMER_PHOTO=../$(basename "$PIECE")/$PERFORMER_PHOTO"
    echo "SONG=inputs/song.wav"; echo "LYRICS=inputs/lyrics.txt"; echo "LYRICS_CONTEXT=inputs/lyrics-full.txt"
    echo "RUN=test"; echo "TEST_FROM=$ST"; } > "$T/piece.env"
  for f in "$PIECE"/inputs/*; do case $(basename "$f") in visual-treatment.txt) cp "$f" "$T/inputs/";; esac; done
  echo "test piece: $T (${DUR}s from ${ST}s, $(wc -l < "$T/inputs/lyrics.txt") lyric lines)"
  exec "$0" "$T" "${EXTRA[@]}"
fi
if [ -z "$SONG" ]; then
  [ -n "$MUSIC_STYLE" ] || { echo "piece.env: set SONG, or MUSIC_STYLE to generate one"; exit 2; }
  export PIECE MUSIC_STYLE_FILE=$(p "$MUSIC_STYLE") LYRICS_FILE=$(p "$LYRICS") SONG_SEEDS SONG_DURATION
  if need song; then
    bin/make_song.sh "$(p "$MUSIC_STYLE")" "$(p "$LYRICS")" "$PIECE/outputs/song.wav" --seeds "$SONG_SEEDS" \
      --duration "$SONG_DURATION"; made
  fi
  SONGP=$PIECE/outputs/song.wav
else
  SONGP=$(p "$SONG")
fi
# WORKSHOP=1: the directors' workshop (pipeline/workshop.py) in two steps around the universe step: story (the
# conversation and the treatment, inputs/story.md, plus the directors' proposed universe), universe (pipeline/universe.py:
# candidates, 3 picks rendered in the same two shots, the chosen one -> universe.txt and visual-look.txt) and storyboard (from story.md: scenes and a shot per line,
# lyrics-cued.txt and story-scenes.json); LOOK/CUES point at them. The workshop needs the lyric timings (when each line
# is sung, how long the instrumental gaps are), so the analysis runs first
if [ -n "${WORKSHOP:-}" ]; then
  bin/make_video.sh "$SONGP" --lyrics "$(p "$LYRICS")" --style workshop --out "$PIECE/outputs/$RUN" \
    --analysis "$PIECE/analysis" --analysis-only
  export PIECE LYRICS_FILE=$(p "$LYRICS") SEGS=$PIECE/analysis/$(basename "${SONGP%.*}")-true-segments.json
  if need story; then
    echo "[$(date +%H:%M:%S)] directors' workshop: the story"; bin/workshop.sh "$PIECE" --stage story $(redo story); made
  fi
  if need universe; then                                  # the world it is made of, chosen from a sheet of stills
    echo "[$(date +%H:%M:%S)] universe: candidates and stills"; bin/universe.sh "$PIECE" $(redo universe); made
  fi
  if need storyboard; then
    echo "[$(date +%H:%M:%S)] directors' workshop: the storyboard"; bin/workshop.sh "$PIECE" --stage storyboard; made
  fi
  export STORY=$PIECE/inputs/story-scenes.json           # each shot's place in the story (prompts, scenes, transitions)
fi
# the universe chosen in the universe step (inputs/universe.txt: a few words, then its brief) leads and frames every prompt,
# unless piece.env sets STYLE_WORD itself
if [ -n "${WORKSHOP:-}" ] && [ -z "${STYLE_WORD:-}" ] && [ -s "$PIECE/inputs/universe.txt" ]; then
  export STYLE_WORD="$(head -n 1 "$PIECE/inputs/universe.txt")" STYLE_BRIEF="$(tail -n +2 "$PIECE/inputs/universe.txt")"
fi
# the look is the style added to every per-line prompt (the C6 method); DIRECTOR=1 uses the experimental
# whole-video treatment step instead (treatment.py), which lets its own story override the lyrics
if [ -n "${DIRECTOR:-}" ] && [ -n "$LOOK" ]; then LOOKARGS=(--treatment "$(p "$LOOK")")
else LOOKARGS=(--style "${STYLE:-$( [ -f "$(p "$LOOK")" ] && tr '\n' ' ' < "$(p "$LOOK")" || echo "(not written yet)" )}"); fi   # --explain before the story step
exec bin/make_video.sh "$SONGP" --lyrics "$(p "$LYRICS")" "${LOOKARGS[@]}" --name "$NAME-$RUN" --out "$PIECE/outputs/$RUN" \
  --analysis "$PIECE/analysis" ${VIDEO_HOST:+--video-host "$VIDEO_HOST"} ${KEY_HOSTS:+--key-hosts "$KEY_HOSTS"} --ltx-args "$LTX_ARGS" \
  --finish-args "$FINISH_ARGS" --merge-args "$MERGE_ARGS" ${LYRICS_CONTEXT:+--lyrics-context "$(p "$LYRICS_CONTEXT")"} \
  ${CUES:+--cues "$(p "$CUES")"} ${PERFORMER_PHOTO:+--performer-photo "$(realpath --relative-to=. "$(p "$PERFORMER_PHOTO")")"} \
  ${PERFORMER:+--performer "$PERFORMER"} "${EXTRA[@]}"
