# KEY_POOL="thing1 thing2 local tritus"    # keyframes: the piece's VIDEO_HOST first, then the first free box here
# ROCM_HOSTS=tritus                        # hosts in KEY_HOSTS that are AMD/ROCm (podman)
# LLM_SERVER=~/.local/bin/llama-server
